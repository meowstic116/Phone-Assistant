<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A little phone-shaped creature that walks around your screen and talks back."
            android:textColor="@color/textDim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent"
            android:text="Start assistant"
            android:textColor="@color/onAccent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pipSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Pip settings" />

        <Button
            android:id="@+id/toysButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accentDim"
            android:text="@string/toys_menu"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surfaceAlt"
            android:text="Chat history"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/tasksButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surfaceAlt"
            android:text="@string/tasks_menu"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/crashPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/surfaceAlt"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/crashClear"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Clear crash record"
            android:textColor="@color/textDim"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:text="@string/main_privacy_summary"
            android:textColor="@color/textDim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
