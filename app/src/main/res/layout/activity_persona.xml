<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Personality"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Using the built-in prompt."
        android:textColor="@color/textDim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/useDefaultButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="use new built-in"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/restoreButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="bring my text back"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="This is what Pip is told about who he is. Edit it however you like — the note about which app you are in is added automatically and is not part of this text."
        android:textColor="@color/textDim"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/promptField"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/overlay_panel"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/accent"
        android:text="Save"
        android:textColor="@color/onAccent"
        android:textStyle="bold" />
</LinearLayout>
