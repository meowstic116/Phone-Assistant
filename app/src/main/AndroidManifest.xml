<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Draws the character over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps the character alive while you use other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read-only: lets Pip tell you when Android is blocking Maps' location, and offer
         the Settings toggle. Pip never requests the permission and never tracks you,
         so the Android 12 dual-request rule for apps that DO request it doesn't apply. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />

    <!-- Lets Pip ask Android to use a connected car's microphone while listening.
         Requested at runtime on Android 12+; without it the phone mic is used. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Which app is in the foreground. Granted by the user under "Usage access";
         it exposes app names only, never screen contents. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed on Android 11+ to resolve the label of whatever app is in front. -->
    <queries>
        <provider android:authorities="androidx.car.app.connection" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.google.android.apps.weather" />
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".PipApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_pip"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pip">

        <service android:name=".WakeListenService" android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".KokoroSpeechService"
            android:exported="false"
            android:process=":kokoro" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ToysActivity"
            android:exported="false"
            android:label="@string/toys_menu" />

        <activity
            android:name=".TasksActivity"
            android:exported="false"
            android:label="@string/tasks_menu" />

        <activity
            android:name=".PlantCollectionActivity"
            android:exported="false"
            android:label="@string/plant_collection_title" />

        <activity
            android:name=".PaintingGalleryActivity"
            android:exported="false" />

        <activity
            android:name=".PipSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PersonaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ReadMessageActivity" android:exported="true"
            android:excludeFromRecents="true" android:label="@string/read_message_with_pip">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DebugOptionsActivity"
            android:exported="false"
            android:label="@string/debug_options" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <!-- Local credential storage and authenticated recovery, separate from phone jobs. -->
        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The keyboard watcher reports bounds. Only requested phone jobs and explicit
             screen questions use the same service to read visible app labels. -->
        <service
            android:name=".ImeWatcher"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ime_watcher" />
        </service>

        <service
            android:name=".PipMediaAccess"
            android:exported="true"
            android:label="@string/permissions_now_playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".PipBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An animated character that stays visible on the user's screen." />
        </service>
    </application>
</manifest>
